{
  "cli": {
    "version": ">= 5.9.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "abiFilters": [
          "arm64-v8a"
        ],
        "minifyEnabled": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
